# Copy to .env.local and fill in. Never commit real values.
# Only DATABASE_URI is needed for local dev; everything else has a safe fallback.
# VERCEL and NODE_ENV are also read by the code but are set by the platform and
# the tooling, never here.

# Postgres. Matches docker-compose.yml (bun run db:up).
DATABASE_URI=postgres://svnord:svnord_dev@localhost:5432/svnord

# Payload JWT secret. Required on Vercel (payload.config.ts refuses to start
# without it); locally it falls back to an insecure dev value. Use 32+ random
# characters, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Public origin. Payload serverURL and the revalidate hook fall back to
# http://localhost:3000; metadata, JSON-LD, robots and sitemap (lib/site.ts)
# fall back to https://www.svnord.de. NEXT_PUBLIC_, so changing it needs a redeploy.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret between the Payload afterChange hooks and /api/revalidate.
# Empty: hooks skip revalidation and the endpoint rejects every call.
REVALIDATE_SECRET=dev-revalidate-secret

# Contact form mail via Resend. Without API key and sender, submissions are
# still stored in Payload but no mail goes out. Recipient defaults to
# info@svnord.de. Production still sends from an interim domain, see docs/RUNBOOK.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=info@svnord.de

# Vercel Blob media storage. Leave empty locally (uploads go to public/uploads/).
# Payload only uses the store inside a Vercel deployment, so a production token
# pulled in by `vercel env pull` is harmless locally. BLOB_ENABLE_LOCAL=true
# opts in to the real store for one run; anything uploaded then lands in the
# store the live site reads from.
BLOB_READ_WRITE_TOKEN=
BLOB_ENABLE_LOCAL=

# Only the exact value "true" makes an image uploaded through /admin win over a
# same-named file in public/uploads (lib/publicUploads.ts). Any other value is
# off. NEXT_PUBLIC_, so changing it needs a redeploy.
NEXT_PUBLIC_PREFER_UPLOADED_MEDIA=

# /api/chat (Nord-Assistent). Without a key the route answers 500.
# OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. lib/clubshop.ts fetches the club shop through Firecrawl when set,
# otherwise with a direct fetch.
FIRECRAWL_API_KEY=

# Dev only. Only the value "1" has an effect: it hides the Next.js dev-tools
# indicator (next.config.ts), used when recording the admin tutorial video.
NEXT_HIDE_DEV_INDICATOR=

# Scripts only (scripts/*.ts). Not needed by the app; set per run.
# "true" disables Payload's Drizzle schema push (payload.config.ts):
# PAYLOAD_DISABLE_PUSH=
# "true" skips the DB check before `bun run build` (scripts/preflight-db.ts):
# SKIP_DB_PREFLIGHT=
# Password for admin@svnord.de, created by scripts/seed.ts; no admin without it:
# PAYLOAD_ADMIN_PASSWORD=
# "true" lets scripts/seed.ts run against a non-local database:
# SEED_ALLOW_REMOTE=
# Comma-separated slugs that scripts/import-news.ts overwrites instead of skipping:
# UPDATE_SLUGS=
# CMS logins written by scripts/set-cms-credentials.ts:
# CMS_ADMIN_USERNAME=
# CMS_ADMIN_PASSWORD=
# CMS_VEREIN_USERNAME=
# CMS_VEREIN_PASSWORD=
