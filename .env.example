# Postgres
DATABASE_URI=postgres://svnord:svnord_dev@localhost:5432/svnord

# Payload
PAYLOAD_SECRET=replace-with-32-char-random-string

# Public site URL (used by Payload for asset paths and revalidation)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Internal: token used by Payload afterChange hooks to call /api/revalidate.
# Used in P4. Set to any random string for dev.
REVALIDATE_SECRET=dev-revalidate-secret

# Resend — leave empty in dev (submissions still save to Payload)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=info@svnord.de

# Vercel Blob — leave empty in dev (uploads land on local disk in public/uploads/).
# Set in production (Vercel Storage → Blob auto-injects it) to enable durable
# CMS image uploads from /admin. When unset, the blob plugin disables itself.
BLOB_READ_WRITE_TOKEN=

# Media resolution: when "true", uploaded images (Vercel Blob URLs) win over the
# committed /public/uploads assets of the same name — so the club can replace any
# image from /admin. Flip this on ONLY AFTER reseeding production against a live
# Blob store, so every media doc holds a fresh URL. Leave unset/false otherwise.
NEXT_PUBLIC_PREFER_UPLOADED_MEDIA=

# Seed safety: scripts/seed.ts refuses to run against a Neon (production) DB
# unless this is set to "true". Keep it UNSET for local dev. Only set it for the
# intentional production reseed step.
ALLOW_PROD_SEED=

# OpenAI key for /api/chat (Nord-Assistent)
OPENAI_API_KEY=
# optional override, defaults to gpt-4o-mini
OPENAI_MODEL=

# === AI-Studio (client self-service change tool) ===
# Where new change-request notifications go (the developer). Falls back to
# RESEND_TO_EMAIL then info@svnord.de. Needs RESEND_API_KEY + RESEND_FROM_EMAIL.
DEV_NOTIFY_EMAIL=
# Anthropic key for the agent pipeline (Claude Agent SDK). Server/worker only,
# never shipped to the browser. Set a hard monthly spend cap on this key.
ANTHROPIC_API_KEY=
# Shared secret for the agent worker -> /api/agent/* callbacks (verify webhooks).
AGENT_WEBHOOK_SECRET=
