{
  "name": "nord-lerchenau",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bun run scripts/preflight-db.ts && next build",
    "build:nodb": "SKIP_DB_PREFLIGHT=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "husky",
    "db:push-schema": "NODE_ENV=test PAYLOAD_DISABLE_PUSH=false bun --conditions=production run scripts/push-schema.ts",
    "payload": "payload",
    "payload:generate-types": "bun --conditions=production run scripts/generate-types.ts",
    "payload:migrate": "payload migrate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "seed": "bun run scripts/seed.ts",
    "download-images": "bun run scripts/download-images.ts",
    "media-usage": "bun run scripts/media-usage.ts",
    "legal-pages-aktualisieren": "NODE_ENV=production PAYLOAD_DISABLE_PUSH=true bun --conditions=production run scripts/update-legal-pages.ts",
    "seed-abteilungs-zahlen": "NODE_ENV=production PAYLOAD_DISABLE_PUSH=true bun --conditions=production run scripts/seed-abteilungs-zahlen.ts",
    "import-static-images": "NODE_ENV=production PAYLOAD_DISABLE_PUSH=true bun --conditions=production run scripts/import-static-images.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-vercel-blob": "3.83.0",
    "@payloadcms/translations": "3.83.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "bfv-api": "^1.3.3",
    "driver.js": "^1.8.0",
    "graphql": "^16.13.2",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.23.0",
    "motion": "^12.38.0",
    "next": "16.2.11",
    "payload": "3.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "2.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
