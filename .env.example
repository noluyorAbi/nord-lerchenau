# Postgres
DATABASE_URI=postgres://svnord:svnord_dev@localhost:5432/svnord

# Payload
PAYLOAD_SECRET=replace-with-32-char-random-string

# Public site URL (used by Payload for asset paths and revalidation)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Internal: token used by Payload afterChange hooks to call /api/revalidate.
# Used in P4. Set to any random string for dev.
REVALIDATE_SECRET=dev-revalidate-secret

# Resend — leave empty in dev (submissions still save to Payload)
# INTERIM (2026-07-06): FROM sendet von verifizierter Domain adatepe.dev,
# da svnord.de noch nicht in Resend verifiziert ist. TODO: Vereins-Resend-Konto
# + svnord.de per DNS verifizieren, dann FROM auf kontakt@svnord.de umstellen.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SV Nord Kontakt <kontakt@adatepe.dev>
RESEND_TO_EMAIL=info@svnord.de

# Vercel Blob: leave empty in dev (uploads land in public/uploads/).
# WARNING: Vercel sets this key for Development too, so `vercel env pull` drops a
# live PRODUCTION token in here. Payload only arms blob uploads inside a Vercel
# deployment (see BLOB_ENABLED in payload.config.ts), so a filled token alone is
# harmless locally. To deliberately test the upload path against the real store,
# set BLOB_ENABLE_LOCAL=true for that one run; anything you upload then lands in
# the store the live site reads from.
BLOB_READ_WRITE_TOKEN=
BLOB_ENABLE_LOCAL=

# Media resolution: with this set to literally "true", an image uploaded through
# /admin wins over a same-named file committed in public/uploads, so the club can
# replace shipped images. Leave empty until scripts/migrate-media-to-blob.ts
# --apply has moved every existing media file into the blob store; before that it
# would blank legacy images instead of repairing them. Any other value (1, TRUE,
# yes) is treated as off. NEXT_PUBLIC_, so changing it needs a redeploy.
NEXT_PUBLIC_PREFER_UPLOADED_MEDIA=

# OpenAI key for /api/chat (Nord-Assistent)
OPENAI_API_KEY=
# optional override, defaults to gpt-4o-mini
OPENAI_MODEL=

# Dev only: hides the Next.js dev-tools bubble, used when screen-recording the
# admin for the tutorial video (video/storyboard.json). Leave empty otherwise.
NEXT_HIDE_DEV_INDICATOR=
