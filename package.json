{
  "name": "nord-lerchenau",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run scripts/preflight-db.ts && next build",
    "build:nodb": "SKIP_DB_PREFLIGHT=true next build",
    "db:push-schema": "NODE_ENV=test PAYLOAD_DISABLE_PUSH=false bun --conditions=production run scripts/push-schema.ts",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "payload:generate-types": "bun --conditions=production run scripts/generate-types.ts",
    "payload:migrate": "payload migrate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "seed": "bun run scripts/seed.ts",
    "download-images": "bun run scripts/download-images.ts",
    "media-usage": "bun run scripts/media-usage.ts",
    "import-static-images": "bun --conditions=production run scripts/import-static-images.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.83.0",
    "@payloadcms/live-preview-react": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-vercel-blob": "3.83.0",
    "@payloadcms/translations": "3.83.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "bfv-api": "^1.3.3",
    "driver.js": "^1.8.0",
    "graphql": "^16.13.2",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.23.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "payload": "3.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "2.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
